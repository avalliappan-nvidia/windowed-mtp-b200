# ==========================================================================
# Central configuration for the Windowed-MTP reproduction package (B200).
# Every script sources this file. Edit the paths below to match your machine,
# then follow README.md top to bottom.
# ==========================================================================

# --- where this repro package lives (auto-detected; usually no need to edit) ---
REPRO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# --- container image (SGLang 26.06, includes FlashInfer + NVFP4 kernels) ------
# Pulled/imported by setup/01_get_image.sh.
IMAGE_TAG="nvcr.io/nvidia/sglang:26.06-py3"
# For enroot/pyxis clusters, a prebuilt squashfs is faster than a per-run import:
IMAGE_SQSH="${REPRO_ROOT}/sglang_26.06-py3.sqsh"

# --- which container engine to use: "docker" or "enroot" ----------------------
# Honor an explicit CONTAINER_ENGINE if set; otherwise auto-detect: prefer docker
# when present, fall back to enroot (SLURM/pyxis clusters where only `srun`
# exists). This avoids the common "docker: command not found" / silent-stall on
# SLURM nodes. Override any time with `CONTAINER_ENGINE=enroot bash run/...`.
if [ -z "${CONTAINER_ENGINE:-}" ]; then
  if command -v docker >/dev/null 2>&1; then
    CONTAINER_ENGINE=docker
  elif command -v srun >/dev/null 2>&1; then
    CONTAINER_ENGINE=enroot
  else
    CONTAINER_ENGINE=docker
  fi
fi

# --- host directories (created by the setup scripts) --------------------------
# Patched SGLang source tree (produced by setup/03_apply_patch.sh); mounted over
# the container's site-packages so our windowing/ring code is active.
SGLANG_SRC="${REPRO_ROOT}/sglang_patched"
# HuggingFace cache / model download target (populated by setup/02_get_models.sh).
HF_CACHE="${HF_CACHE:-${REPRO_ROOT}/hf_cache}"
# Long-context input corpora (built by setup/02_get_models.sh via src/gen_ruler.py;
# the headline RULER enum jsonl land in $DATA_DIR/ruler_qa_1m/).
DATA_DIR="${REPRO_ROOT}/data"
# Result JSONL + per-run logs land here.
RESULTS_DIR="${REPRO_ROOT}/results"
LOGS_DIR="${REPRO_ROOT}/logs"
# JIT / kernel caches (flashinfer, triton, torch inductor). Mounted at
# /root/.cache inside the container: flashinfer hard-codes $HOME/.cache/flashinfer
# and the container's HOME (/root) is not writable, so a host bind-mount here is
# required (and lets the compiled kernels persist across runs).
CACHE_DIR="${CACHE_DIR:-${REPRO_ROOT}/.cache}"

# --- host-side Python venv ----------------------------------------------------
# Used only on the HOST for model download (huggingface_hub CLI) and result
# parsing. The headline RULER corpora are built by src/gen_ruler.py, which is
# dependency-free (stdlib only). The venv avoids the PEP 668
# "externally-managed-environment" pip error on modern distros. Created by
# setup/00_venv.sh (or on demand by setup/02_get_models.sh). Auto-activated below
# if present, so `python`/`hf` resolve to the venv for every later setup/*.sh.
VENV="${REPRO_ROOT}/.venv"
if [ -f "${VENV}/bin/activate" ]; then
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
fi

# --- the three evaluated checkpoints (HuggingFace ids) ------------------------
# Qwen models reach ~1.05M ctx (from native 262144) via a YaRN factor of 4 that
# setup/02_get_models.sh bakes into a local config.json (see below). Nemotron is
# native NoPE (no rope edit). See README for details.
# NOTE: q122 MUST be the nvidia checkpoint. The RedHatAI/Qwen3.5-122B-A10B-NVFP4
# repackage ships WITHOUT the MTP (next-n) draft head (0 `mtp.*` tensors vs 785 in
# the nvidia repo), so SGLang loads an untrained draft -> every token is rejected
# -> AL pins at 1.0 (no speculation). RedHatAI's 35B does include the MTP head, so
# q35 is fine on either; we keep it on RedHatAI to match the paper's runs.
MODEL_Q35="RedHatAI/Qwen3.6-35B-A3B-NVFP4"
MODEL_Q122="nvidia/Qwen3.5-122B-A10B-NVFP4"
MODEL_NEMO="nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4"

# --- local YaRN-prepared model dirs (built by setup/02_get_models.sh) ---------
# Lightweight dirs: all weights/tokenizer files are symlinked from the HF cache,
# with a REAL config.json whose text_config.rope_parameters is switched to YaRN
# factor 4 and max_position_embeddings raised to ~1.05M. We bake this on disk
# (rather than runtime --yarn-factor) because these are multimodal configs and a
# partial text_config override drops num_attention_heads -> engine init crash.
MODELS_DIR="${REPRO_ROOT}/models"
Q35_LOCAL="${MODELS_DIR}/$(basename "$MODEL_Q35")-yarn4"
Q122_LOCAL="${MODELS_DIR}/$(basename "$MODEL_Q122")-yarn4"

# The path SGLang lives at inside the container (used for the bind-mount).
SGLANG_IN_CONTAINER="/usr/local/lib/python3.12/dist-packages/sglang"
